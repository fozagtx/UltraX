# OKX Web3 API credentials (optional; collector skips OKX jobs without them)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# Address that receives x402 payments (required)
PAY_TO_ADDRESS=
# CAIP-2 network: eip155:196 mainnet (default), eip155:1952 testnet
NETWORK=eip155:196
# X Layer RPC endpoints
XLAYER_RPC_URL=https://rpc.xlayer.tech
XLAYER_RPC_URL_BACKUP=https://xlayerrpc.okx.com
# Postgres connection string (required)
DATABASE_URL=postgres://localhost:5432/ultrax
# HTTP listen port
PORT=8080
# Public base URL used to print absolute URLs in /catalog
PUBLIC_API_BASE_URL=http://localhost:8080
# Set to "false" to disable the collector
COLLECTOR_ENABLED=true
# OKX Web3 API base URL
OKX_BASE_URL=https://web3.okx.com
# Days of USDT0 history to backfill via RPC
BACKFILL_DAYS=30
