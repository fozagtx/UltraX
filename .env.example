# Address that receives x402 payments (required)
PAY_TO=
# CAIP-2 network: eip155:196 mainnet (default), eip155:1952 testnet
NETWORK=eip155:196
# X Layer RPC endpoints
XLAYER_RPC_URL=https://rpc.xlayer.tech
XLAYER_RPC_URL_BACKUP=https://xlayerrpc.okx.com
# HTTP listen port
PORT=8080
# Public base URL used in /catalog and printed curls
PUBLIC_API_BASE_URL=http://localhost:8080
# CORS origin (default *)
WEB_ORIGIN=*
# OKX Web3 API credentials (optional; without them the 402 challenge still
# works but /check, /status xlayer parts and the facilitator are degraded)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# OKX Web3 API base URL
OKX_BASE_URL=https://web3.okx.com
